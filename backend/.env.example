# VIPsync Backend - Supabase (required)
# Copy to .env and fill in values

# Supabase project URL (same as EXPO_PUBLIC_SUPABASE_URL)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Service role key - bypasses RLS (get from Supabase Dashboard > Settings > API)
# Keep secret - never expose to frontend
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Supabase JWT secret - for verifying Supabase session tokens (POST /api/auth/supabase).
# Must match exactly: Supabase Dashboard → Project Settings → API → JWT Secret (not the anon key).
# If frontend gets "no auth token" after sign-in, backend returns 401 until this matches.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# JWT signing (required for access tokens)
JWT_SECRET=your_jwt_secret_change_in_production

# FCM (push): one of these for sending push notifications
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=./path/to/firebase-service-account.json
