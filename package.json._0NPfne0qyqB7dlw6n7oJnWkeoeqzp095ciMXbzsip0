{
  "name": "expo-template-tabs",
  "main": "expo-router/entry",
  "description": "The Tab Navigation project template includes several example screens.",
  "license": "0BSD",
  "version": "54.0.55",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:reverse": "adb reverse tcp:8081 tcp:8081",
    "android:reverse:8085": "adb reverse tcp:8085 tcp:8085",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "clean": "npx expo prebuild --clean",
    "clean:android": "if exist android rmdir /s /q android && if exist node_modules\\@react-native-community\\datetimepicker\\android\\build rmdir /s /q node_modules\\@react-native-community\\datetimepicker\\android\\build && if exist node_modules\\react-native-safe-area-context\\android\\build rmdir /s /q node_modules\\react-native-safe-area-context\\android\\build && if exist node_modules\\expo-modules-core\\android\\.cxx rmdir /s /q node_modules\\expo-modules-core\\android\\.cxx",
    "build:android": "eas build --platform android --profile preview",
    "build:android:prod": "eas build --platform android --profile production",
    "build:android:local": "npx expo prebuild && cd android && gradlew.bat assembleRelease && cd ..",
    "db:push": "supabase db push",
    "backend:dev": "cd backend && npm run dev",
    "backend:start": "cd backend && npm start",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
