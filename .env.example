# Frontend (Expo) — copy to .env and fill in.
# Restart Expo after changing: npx expo start --clear

# Backend API base URL (no trailing slash). Required for app ↔ backend communication.
# - Android emulator: http://10.0.2.2:3000
# - iOS simulator:   http://127.0.0.1:3000
# - Physical device: http://YOUR_PC_LAN_IP:3000 (e.g. ipconfig / ifconfig)
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Supabase (auth + optional direct client)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
